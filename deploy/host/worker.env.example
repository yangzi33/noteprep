# Install to /etc/noteprep/worker.env as root:root 0600. PLACEHOLDERS ONLY here.
# Never commit real values, bake them into an image, or make them readable by the runner account.
NODE_ENV=production
COMPILER=docker
# Pinned by digest (required in production).
LATEX_IMAGE=ghcr.io/<owner>/noteprep-latex@sha256:<digest>
WORKER_DATABASE_URL=<postgres connection string for the worker role>
OBJECT_STORE=supabase
SUPABASE_URL=<https://project-ref.supabase.co>
SUPABASE_SECRET_KEY=<supabase secret key>
# First rehearsal uses fake/template; switch to anthropic/llm only with all four LLM values below.
LLM_PROVIDER=fake
LESSON_PROSE=template
# LLM_API_KEY=<provider api key>
# LLM_MODEL=<model id>
# LLM_PRICE_INPUT_MICROS_PER_MTOK=<integer>
# LLM_PRICE_OUTPUT_MICROS_PER_MTOK=<integer>
WORKER_ID=staging-1
# DOCKER_HOST and WORKER_LIVENESS_FILE are set by the image; do not override them here.
