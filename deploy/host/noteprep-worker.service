# Install to /etc/systemd/system/noteprep-worker.service (root:root 0644).
# The worker container reaches ONLY the sandbox runner's socket directory; it never gets the host daemon's socket.
[Unit]
Description=Noteprep worker container
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
# Foreground output is the single log: journalctl -u noteprep-worker (container log driver is none).
# Non-secret: WORKER_IMAGE (pinned by digest) and RUNNER_GID. Secrets live only in /etc/noteprep/worker.env.
EnvironmentFile=/etc/noteprep/worker.image
# Refuse to start unless the image is pinned by digest (name@sha256:<64 lowercase hex>). $$ is systemd's escape for a literal $.
ExecStartPre=/bin/sh -c 'case "$$WORKER_IMAGE" in *[!A-Za-z0-9._:/@-]*) exit 1;; esac; printf %%s "$$WORKER_IMAGE" | grep -Eq "^[^@]+@sha256:[0-9a-f]{64}$$"'
ExecStartPre=-/usr/bin/docker rm -f noteprep-worker
ExecStart=/usr/bin/docker run --rm --name noteprep-worker --init --read-only --tmpfs /tmp:rw,noexec,nosuid,nodev,size=64m --tmpfs /run/noteprep:rw,noexec,nosuid,nodev,size=1m,uid=10001,gid=10001 --user 10001:10001 --group-add ${RUNNER_GID} --cap-drop ALL --security-opt no-new-privileges --pids-limit 256 --memory 1g --memory-swap 1g --cpus 1 --pull never --env-file /etc/noteprep/worker.env --mount type=bind,source=/run/noteprep-runner,target=/run/noteprep-runner,readonly --stop-timeout 180 --log-driver none ${WORKER_IMAGE}
ExecStop=/usr/bin/docker stop --time 180 noteprep-worker
TimeoutStopSec=200
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
