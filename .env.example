# Placeholders only. Never put real secrets in this file; copy to .env for local development.
# Which environment may hold which secret: docs/architecture.md section 2.

# Owner role used only by `pnpm db:migrate:deploy` / `db:migrate:dev` (never by the running app).
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Web runtime connection: the app_runtime login user created by `pnpm db:dev-roles`.
DATABASE_URL="postgresql://web_login:dev-only-password@127.0.0.1:54322/postgres"

# Browser-safe values. Take the publishable key from `pnpm supabase:status`.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable key from pnpm supabase:status>"
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"
# NEXT_PUBLIC_SUPPORT_EMAIL="<support address>"  # optional; shown to users as a contact address; leave unset to show wording only

# Worker (pnpm worker:dev): the worker_runtime login user created by `pnpm db:dev-roles`.
# Phase 1 has no real compiler; the skeleton compiler must be requested explicitly (never in production).
WORKER_DATABASE_URL="postgresql://worker_login:dev-only-password@127.0.0.1:54322/postgres"
ALLOW_FAKE_COMPILER="1"
# Tests/local only: makes the placeholder compiler fail every compile, to rehearse the failed-export path. Refused with
# COMPILER=docker and in production. Never set it on a host.
# SKELETON_COMPILER_FAIL="compile_failed"

# Prepare flow (D-106). Defaults since S6: FLOW_MODE="draft" (free draft preview, charge only at export) and EXPORT_ENABLED="1".
# Both are kill switches: FLOW_MODE="legacy" restores the old generate flow; EXPORT_ENABLED="0" pauses export (pending exports still settle).
# Set both explicitly in every hosted environment. Exports need a running worker (pnpm worker:dev locally).
# FLOW_MODE="draft"
# EXPORT_ENABLED="1"
# Export limits (placeholders, see src/lib/server/limits.ts): EXPORTS_PER_USER_PER_HOUR, EXPORT_CONCURRENCY_PER_USER,
# EXPORT_DEADLINE_MINUTES, EXPORT_MAX_ATTEMPTS, EXPORT_DEADLINE_GRACE_SECONDS, EXPORT_MAX_QUEUED_GLOBAL,
# EXPORT_CONFIRM_ATTEMPTS_PER_USER_PER_HOUR (default 60; counts each new confirm before the heavy render)
# Sign-in recovery emails (reset link, confirmation resend): per client IP and kind per hour, integer 1 to 1000 (default 10)
# AUTH_EMAIL_PER_IP_PER_HOUR="10"
# The same across all addresses, per kind, integer 1 to 100000 (default 200)
# AUTH_EMAIL_GLOBAL_PER_HOUR="200"
# Free daily refresh: temporary beta perk, D-112, web app only (the worker does not read these). Off by default.
# DAILY_REFRESH_ENABLED="0"
# DAILY_REFRESH_LIMIT="5"
# Operator top-up route (D-113), web app only. Off by default; when "1", ADMIN_REFRESH_TOKEN (>= 32 characters) is required.
# Keep the token in the hosted server environment only, never in a NEXT_PUBLIC_* variable. Placeholder, not a real value.
# ADMIN_REFRESH_ENABLED="0"
# ADMIN_REFRESH_TOKEN="<random string of at least 32 characters>"
# Orphan object reconciler (worker; deletes only stored objects no manifest references, writes no database rows). OFF by default:
# it is destructive, so enable it per environment after a rehearsal. All values below are placeholders.
# RECONCILE_ENABLED="0"
# RECONCILE_BATCH_LESSONS="20"          # lessons per pass (1-500)
# RECONCILE_INTERVAL_SECONDS="300"      # at most one pass per interval (30-86400)
# RECONCILE_GRACE_SECONDS="1800"        # must be at least LEASE_SECONDS + EXPORT_DEADLINE_GRACE_SECONDS + 60 (checked only when enabled)
# RECONCILE_STEP_BUDGET_SECONDS="60"    # wall-clock budget of one pass (5-600); runs in its own loop, never delays job recovery
# Draft limits are placeholders (src/lib/server/limits.ts lists every variable, e.g. DRAFT_TTL_DAYS="14").
# Drafts expire DRAFT_TTL_DAYS after the last change (sliding), but never later than DRAFT_MAX_LIFETIME_DAYS after creation.
# DRAFT_MAX_LIFETIME_DAYS="60"
# A draft operation waits at most DRAFT_LOCK_TIMEOUT_MS for a row lock, then reports "busy".
# DRAFT_LOCK_TIMEOUT_MS="5000"

# Show the labelled SAMPLE curriculum dataset (development/staging only; leave unset in production).
CURRICULUM_ALLOW_SAMPLE="1"

# Worker: language model for lesson wording. "fake" needs no credentials and is the default.
# LLM_PROVIDER="fake"
# LESSON_PROSE="template"          # "llm" asks the provider for the wording of curriculum lessons
# LLM_API_KEY=""                   # only when LLM_PROVIDER="anthropic"; held by the worker alone
# LLM_MODEL=""                     # a model id from the provider's current list
# LLM_PRICE_INPUT_MICROS_PER_MTOK="0"    # placeholders: set from the provider's current price list
# LLM_PRICE_OUTPUT_MICROS_PER_MTOK="0"
# LLM_MAX_OUTPUT_TOKENS="4000"

# Worker: compiler for the lesson PDFs. "skeleton" writes labelled placeholder files and needs ALLOW_FAKE_COMPILER="1".
# COMPILER="docker"                   # real compilation in the sandbox image: pnpm latex:image, then run the worker
# LATEX_IMAGE="noteprep-latex:dev"    # production must be pinned by digest: name@sha256:...
# LATEX_WALL_CLOCK_SECONDS="90"

# Worker: where the finished PDFs go. "fs" = local disk (.data/objects); "supabase" = the private Storage bucket
# "lesson-artifacts" (needed for the preview and download pages). The secret key is for the worker ONLY; never give it to the web app.
# OBJECT_STORE="supabase"
# SUPABASE_URL="http://127.0.0.1:54321"
# SUPABASE_SECRET_KEY="<secret key from pnpm supabase:status>"

# Worker on the staging host (docs/worker-host-runbook.md, deploy/host/worker.env.example). Both values are set BY THE IMAGE; do not put them in /etc/noteprep/worker.env.
# DOCKER_HOST: the Docker client's daemon address. Locally leave it unset (default daemon). In production it MUST be the sandbox
#   runner's unix socket (the image sets unix:///run/noteprep-runner/docker.sock); the worker refuses to start if it is unset in production or names the host's
#   rootful daemon (unix:///var/run/docker.sock). Never mount the host's docker.sock into the worker.
# WORKER_LIVENESS_FILE: absolute path the worker touches while it can reach the database; the container healthcheck reads it (image: /run/noteprep/alive).
# DOCKER_HOST=""
# WORKER_LIVENESS_FILE=""
