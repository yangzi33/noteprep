// Schema for docs/architecture.md section 5.
// Constraints Prisma cannot express (CHECKs, partial unique indexes, triggers, roles,
// RLS) live as hand-written SQL in the migration named *_constraints_roles_rls.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProfileStatus {
  active
  deleting

  @@map("profile_status")
}

enum JobKind {
  generate
  compile

  @@map("job_kind")
}

enum JobState {
  queued
  running
  succeeded
  failed
  canceled

  @@map("job_state")
}

enum JobStage {
  generating
  validating
  compiling
  storing

  @@map("job_stage")
}

enum BucketKind {
  trial
  paid

  @@map("bucket_kind")
}

enum ReservationState {
  reserved
  consumed
  released

  @@map("reservation_state")
}

enum RevisionStatus {
  draft
  finalized
  rejected

  @@map("revision_status")
}

enum ValidationStatus {
  verified
  failed
  unverified

  @@map("validation_status")
}

enum WebhookEventStatus {
  received
  processing
  processed
  failed

  @@map("webhook_event_status")
}

/// Application profile; `id` equals the Supabase Auth user id.
model Profile {
  id                  String        @id @db.Uuid
  status              ProfileStatus @default(active)
  stripeCustomerId    String?       @unique @map("stripe_customer_id")
  deletionRequestedAt DateTime?     @map("deletion_requested_at") @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  lessons       Lesson[]
  jobs          GenerationJob[]
  buckets       UsageBucket[]
  reservations  UsageReservation[]
  subscriptions Subscription[]
  idempotency   IdempotencyKey[]

  @@map("profile")
}

model Lesson {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId             String    @map("owner_id") @db.Uuid
  title               String
  inputSpec           Json      @map("input_spec")
  /// Must point at a revision of this same lesson: FK (current_revision_id, id) -> (id, lesson_id).
  currentRevisionId   String?   @map("current_revision_id") @db.Uuid
  /// 1 = the original free-form request, 2 = curriculum selection (docs/refactor-plan.md section 3).
  requestVersion      Int       @default(1) @map("request_version")
  /// Pinned curriculum version and topic for v2 lessons; null for v1. Never changes after creation.
  curriculumVersionId String?   @map("curriculum_version_id")
  topicId             String?   @map("topic_id")
  objectiveIds        String[]  @default([]) @map("objective_ids")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner             Profile            @relation(fields: [ownerId], references: [id])
  currentRevision   LessonRevision?    @relation("CurrentRevision", fields: [currentRevisionId, id], references: [id, lessonId], onDelete: NoAction, onUpdate: NoAction)
  curriculumVersion CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  topic             CurriculumTopic?   @relation(fields: [topicId, curriculumVersionId], references: [id, versionId], onDelete: Restrict)
  revisions         LessonRevision[]   @relation("LessonRevisions")
  jobs              GenerationJob[]

  @@unique([id, ownerId])
  @@map("lesson")
}

model LessonRevision {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId         String           @map("lesson_id") @db.Uuid
  ownerId          String           @map("owner_id") @db.Uuid
  number           Int
  status           RevisionStatus
  schemaVersion    Int              @map("schema_version")
  content          Json
  contentHash      String           @map("content_hash")
  validationReport Json             @map("validation_report")
  validationStatus ValidationStatus @map("validation_status")
  acknowledgement  Json?
  sourceRevisionId String?          @map("source_revision_id") @db.Uuid
  templateVersion  String?          @map("template_version")
  validatorVersion String           @map("validator_version")
  generationMeta   Json?            @map("generation_meta")
  /// Write-once (NULL -> value) for finalized revisions; enforced by trigger.
  artifactManifest Json?            @map("artifact_manifest")
  createdByJobId   String?          @map("created_by_job_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  lesson     Lesson           @relation("LessonRevisions", fields: [lessonId, ownerId], references: [id, ownerId])
  source     LessonRevision?  @relation("RevisionSource", fields: [sourceRevisionId], references: [id])
  derived    LessonRevision[] @relation("RevisionSource")
  jobs       GenerationJob[]
  currentFor Lesson[]         @relation("CurrentRevision")

  @@unique([lessonId, number])
  @@unique([id, ownerId])
  @@unique([id, lessonId])
  @@index([ownerId, createdAt(sort: Desc)])
  @@map("lesson_revision")
}

model GenerationJob {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId           String    @map("owner_id") @db.Uuid
  kind              JobKind
  state             JobState  @default(queued)
  stage             JobStage?
  lessonId          String    @map("lesson_id") @db.Uuid
  /// Compile jobs: the revision to compile. Generate jobs: the revision they published.
  revisionId        String?   @map("revision_id") @db.Uuid
  requestHash       String    @map("request_hash")
  attempt           Int       @default(0)
  maxAttempts       Int       @map("max_attempts")
  runAfter          DateTime  @default(now()) @map("run_after") @db.Timestamptz(6)
  leaseOwner        String?   @map("lease_owner")
  leaseExpiresAt    DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  fencingToken      BigInt    @default(0) @map("fencing_token")
  cancelRequestedAt DateTime? @map("cancel_requested_at") @db.Timestamptz(6)
  deadlineAt        DateTime  @map("deadline_at") @db.Timestamptz(6)
  callsUsed         Int       @default(0) @map("calls_used")
  maxCalls          Int       @map("max_calls")
  tokensUsed        BigInt    @default(0) @map("tokens_used")
  maxTokens         BigInt    @map("max_tokens")
  /// Internal cost accounting in micro-units; not a customer billing amount.
  costMicros        BigInt    @default(0) @map("cost_micros")
  maxCostMicros     BigInt    @map("max_cost_micros")
  errorCode         String?   @map("error_code")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt         DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz(6)

  owner       Profile           @relation(fields: [ownerId], references: [id])
  lesson      Lesson            @relation(fields: [lessonId, ownerId], references: [id, ownerId])
  revision    LessonRevision?   @relation(fields: [revisionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  reservation UsageReservation?

  // Partial indexes (queued by run_after, running by lease) are added in SQL.
  @@index([ownerId, state])
  @@index([ownerId, createdAt(sort: Desc)])
  @@map("generation_job")
}

model IdempotencyKey {
  ownerId      String   @map("owner_id") @db.Uuid
  operation    String
  key          String
  requestHash  String   @map("request_hash")
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner Profile @relation(fields: [ownerId], references: [id])

  @@id([ownerId, operation, key])
  @@map("idempotency_key")
}

model UsageBucket {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId        String     @map("owner_id") @db.Uuid
  kind           BucketKind
  limitCount     Int        @map("limit_count")
  used           Int        @default(0)
  reserved       Int        @default(0)
  startsAt       DateTime   @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime?  @map("ends_at") @db.Timestamptz(6)
  subscriptionId String?    @map("subscription_id") @db.Uuid
  /// Paid buckets: subscription item period start (epoch seconds), docs/decisions.md D-13.
  periodKey      BigInt?    @map("period_key")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  owner        Profile            @relation(fields: [ownerId], references: [id])
  subscription Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  reservations UsageReservation[]

  // One trial bucket per owner is a partial unique index in SQL.
  @@unique([subscriptionId, periodKey])
  @@index([ownerId, kind])
  @@map("usage_bucket")
}

model UsageReservation {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String           @map("owner_id") @db.Uuid
  bucketId     String           @map("bucket_id") @db.Uuid
  jobId        String           @unique @map("job_id") @db.Uuid
  state        ReservationState @default(reserved)
  settleReason String?          @map("settle_reason")
  reservedAt   DateTime         @default(now()) @map("reserved_at") @db.Timestamptz(6)
  settledAt    DateTime?        @map("settled_at") @db.Timestamptz(6)

  owner  Profile       @relation(fields: [ownerId], references: [id])
  bucket UsageBucket   @relation(fields: [bucketId], references: [id])
  job    GenerationJob @relation(fields: [jobId], references: [id])

  @@index([bucketId, state])
  @@map("usage_reservation")
}

model Subscription {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId              String    @map("owner_id") @db.Uuid
  stripeSubscriptionId String    @unique @map("stripe_subscription_id")
  stripePriceId        String    @map("stripe_price_id")
  /// Stripe status string stored as received.
  status               String
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  periodStart          DateTime? @map("period_start") @db.Timestamptz(6)
  periodEnd            DateTime? @map("period_end") @db.Timestamptz(6)
  latestInvoicePaid    Boolean   @default(false) @map("latest_invoice_paid")
  syncedAt             DateTime  @map("synced_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  owner   Profile       @relation(fields: [ownerId], references: [id])
  buckets UsageBucket[]

  // At most one "live" subscription per owner is a partial unique index in SQL.
  @@index([ownerId])
  @@map("subscription")
}

/// Metadata only; full Stripe payloads are intentionally not stored.
model WebhookEvent {
  id            String             @id
  type          String
  objectId      String?            @map("object_id")
  livemode      Boolean
  stripeCreated DateTime?          @map("stripe_created") @db.Timestamptz(6)
  receivedAt    DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  status        WebhookEventStatus @default(received)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastErrorCode String?            @map("last_error_code")
  processedAt   DateTime?          @map("processed_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@map("webhook_event")
}

model RateLimitWindow {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@map("rate_limit_window")
}

// ---------------------------------------------------------------------------------------------------
// Curriculum reference data (docs/curriculum-architecture.md). Public, versioned, read-only for the
// runtime roles. Rows of a published version are immutable (triggers in *_curriculum_guards). Every
// child row repeats `version_id`, and composite foreign keys keep the whole tree inside one version.
// ---------------------------------------------------------------------------------------------------

enum CurriculumVersionStatus {
  draft
  published
  superseded
  withdrawn

  @@map("curriculum_version_status")
}

enum DatasetKind {
  real
  sample
  synthetic
  suggested

  @@map("dataset_kind")
}

enum CoverageLevel {
  full
  partial

  @@map("coverage_level")
}

model EducationSystem {
  id         String   @id
  name       String
  regionCode String   @map("region_code")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  curricula Curriculum[]

  @@map("education_system")
}

model Curriculum {
  id                String   @id
  educationSystemId String   @map("education_system_id")
  subject           String
  name              String
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  educationSystem EducationSystem     @relation(fields: [educationSystemId], references: [id], onDelete: Restrict)
  versions        CurriculumVersion[]

  @@map("curriculum")
}

model CurriculumVersion {
  id                  String                  @id
  curriculumId        String                  @map("curriculum_id")
  label               String
  effectiveFrom       DateTime?               @map("effective_from") @db.Date
  status              CurriculumVersionStatus @default(draft)
  datasetKind         DatasetKind             @map("dataset_kind")
  sourceTitle         String                  @map("source_title")
  sourceUrl           String?                 @map("source_url")
  sourcePublisher     String?                 @map("source_publisher")
  sourceRetrievedAt   DateTime?               @map("source_retrieved_at") @db.Date
  licenseNote         String                  @map("license_note")
  datasetHash         String                  @map("dataset_hash")
  supersedesVersionId String?                 @map("supersedes_version_id")
  reviewedBy          String?                 @map("reviewed_by")
  reviewedAt          DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  reviewScope         String?                 @map("review_scope")
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt         DateTime?               @map("published_at") @db.Timestamptz(6)

  curriculum   Curriculum            @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  supersedes   CurriculumVersion?    @relation("VersionSupersedes", fields: [supersedesVersionId], references: [id], onDelete: Restrict)
  supersededBy CurriculumVersion[]   @relation("VersionSupersedes")
  levels       CurriculumLevel[]
  courses      CurriculumCourse[]
  units        CurriculumUnit[]
  topics       CurriculumTopic[]
  objectives   CurriculumObjective[]
  lessons      Lesson[]

  @@unique([curriculumId, label])
  @@map("curriculum_version")
}

model CurriculumLevel {
  id        String @id
  versionId String @map("version_id")
  label     String
  kind      String
  ordinal   Int

  version CurriculumVersion  @relation(fields: [versionId], references: [id], onDelete: Restrict)
  courses CurriculumCourse[]

  @@unique([id, versionId])
  @@unique([versionId, ordinal])
  @@map("curriculum_level")
}

model CurriculumCourse {
  id        String  @id
  versionId String  @map("version_id")
  levelId   String? @map("level_id")
  code      String
  title     String
  ordinal   Int

  version CurriculumVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  level   CurriculumLevel?  @relation(fields: [levelId, versionId], references: [id, versionId], onDelete: Restrict)
  units   CurriculumUnit[]

  @@unique([id, versionId])
  @@unique([versionId, code])
  @@map("curriculum_course")
}

model CurriculumUnit {
  id        String  @id
  versionId String  @map("version_id")
  courseId  String  @map("course_id")
  code      String?
  title     String
  ordinal   Int

  version    CurriculumVersion     @relation(fields: [versionId], references: [id], onDelete: Restrict)
  course     CurriculumCourse      @relation(fields: [courseId, versionId], references: [id, versionId], onDelete: Restrict)
  topics     CurriculumTopic[]
  objectives CurriculumObjective[]

  @@unique([id, versionId])
  @@unique([courseId, ordinal])
  @@map("curriculum_unit")
}

model CurriculumTopic {
  id        String @id
  versionId String @map("version_id")
  unitId    String @map("unit_id")
  title     String
  summary   String
  ordinal   Int

  version        CurriculumVersion   @relation(fields: [versionId], references: [id], onDelete: Restrict)
  unit           CurriculumUnit      @relation(fields: [unitId, versionId], references: [id, versionId], onDelete: Restrict)
  objectiveLinks TopicObjective[]
  concepts       TopicConcept[]
  prerequisites  TopicPrerequisite[] @relation("TopicRequires")
  requiredBy     TopicPrerequisite[] @relation("TopicRequiredBy")
  lessons        Lesson[]

  @@unique([id, versionId])
  @@unique([unitId, ordinal])
  @@map("curriculum_topic")
}

model CurriculumObjective {
  id           String  @id
  versionId    String  @map("version_id")
  unitId       String  @map("unit_id")
  officialCode String  @map("official_code")
  label        String
  sourceRef    String  @map("source_ref")
  sourcePage   String? @map("source_page")

  version CurriculumVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  unit    CurriculumUnit    @relation(fields: [unitId, versionId], references: [id, versionId], onDelete: Restrict)
  topics  TopicObjective[]

  @@unique([id, versionId])
  @@unique([unitId, officialCode])
  @@map("curriculum_objective")
}

model TopicObjective {
  topicId     String        @map("topic_id")
  objectiveId String        @map("objective_id")
  versionId   String        @map("version_id")
  coverage    CoverageLevel
  note        String?

  topic     CurriculumTopic     @relation(fields: [topicId, versionId], references: [id, versionId], onDelete: Restrict)
  objective CurriculumObjective @relation(fields: [objectiveId, versionId], references: [id, versionId], onDelete: Restrict)

  @@id([topicId, objectiveId])
  @@map("topic_objective")
}

model TopicPrerequisite {
  topicId             String  @map("topic_id")
  prerequisiteTopicId String  @map("prerequisite_topic_id")
  versionId           String  @map("version_id")
  note                String?

  topic        CurriculumTopic @relation("TopicRequires", fields: [topicId, versionId], references: [id, versionId], onDelete: Restrict)
  prerequisite CurriculumTopic @relation("TopicRequiredBy", fields: [prerequisiteTopicId, versionId], references: [id, versionId], onDelete: Restrict)

  @@id([topicId, prerequisiteTopicId])
  @@map("topic_prerequisite")
}

/// Engine-facing concept shared by all curricula. Capabilities live in code (src/lib/curriculum/capabilities.ts);
/// rows are added by migrations.
model Concept {
  id   String @id
  name String

  topics TopicConcept[]

  @@map("concept")
}

model TopicConcept {
  topicId   String        @map("topic_id")
  conceptId String        @map("concept_id")
  versionId String        @map("version_id")
  coverage  CoverageLevel
  note      String?

  topic   CurriculumTopic @relation(fields: [topicId, versionId], references: [id, versionId], onDelete: Restrict)
  concept Concept         @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  @@id([topicId, conceptId])
  @@map("topic_concept")
}
